# =========================
# n8n runtime
# =========================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=change_me
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# WAHA must be able to reach this URL from the shared Docker network.
WEBHOOK_URL=http://n8n:5678
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=change_me_long_random_value
NODE_ENV=production
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# Self-Healing n8n API access. Create the key in your own n8n instance.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=change_me

# =========================
# WAHA runtime (current supplied runtime uses WEBJS)
# =========================
WAHA_PORT=3000
WAHA_API_KEY=change_me
WAHA_DASHBOARD_USERNAME=change_me
WAHA_DASHBOARD_PASSWORD=change_me
WHATSAPP_SWAGGER_USERNAME=change_me
WHATSAPP_SWAGGER_PASSWORD=change_me
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
WAHA_BASE_URL=http://localhost:3000
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# URLs/IDs referenced by sanitized workflow expressions
WAHA_URL=http://waha:3000
WAHA_DASHBOARD_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
WHATSAPP_NOTIFICATION_CHAT_ID=change_me
GOOGLE_DRIVE_FOLDER_ID=change_me
INTERNAL_SERVICE_URL=http://service.invalid

# =========================
# Credential source values (the workflow templates do NOT auto-create n8n credentials)
# Use these values when creating credentials in the n8n UI, or manage them through your own secret store.
# =========================
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
HUGGINGFACE_API_KEY=change_me
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_KEY=change_me_service_role_key
SUPABASE_DB_HOST=supabase-pooler
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=change_me
POSTGRES_HOST=supabase-pooler
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GMAIL_USER=admin@example.com
